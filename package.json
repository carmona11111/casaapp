{
  "name": "casa-al-dia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "serve": "node --env-file-if-exists=.env scripts/serve-local.mjs",
    "build": "node scripts/check-public-secrets.mjs && tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:browser": "npm run build && node tests/browser.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "qrcode": "1.5.4",
    "zod": "4.1.5",
    "lucide-react": "1.48.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/qrcode": "1.5.6",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "@playwright/test": "1.63.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
